# Copy to .env.local (gitignored) and fill in. Vite only exposes variables that start with VITE_.
# SpacetimeDB on maincloud (stdb/README.md)
VITE_STDB_URI=wss://maincloud.spacetimedb.com
VITE_STDB_DATABASE=agentes
# The Approve button: same values as eyeclick/bridge/.env (GLASSES_WEBTRIGGER_URL, APPROVAL_SECRET, PERSON_ID).
# The secret ends up in the browser bundle: run the panel locally only, never deploy it.
VITE_GLASSES_WEBTRIGGER_URL=
VITE_APPROVAL_SECRET=
VITE_PERSON_ID=emiliano
