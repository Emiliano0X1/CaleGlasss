# Copy to .env (gitignored) and fill in.
# From: cd forge-app && forge webtrigger create -f glasses-webtrigger -s <site> -p jira -e development
GLASSES_WEBTRIGGER_URL=
# Same value as the APPROVAL_SECRET encrypted Forge variable
APPROVAL_SECRET=
# Your id in the stdb `people` table (receipts and plans go to its Telegram chat)
PERSON_ID=emiliano
# Index or part of the name from `python -m eyeclick.bridge --list-devices`; empty = system default
MIC_DEVICE=
